# ──────────────────────────────────────────────────────────────────────────────
# OPRO Cronjob Monitor – Environment Variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL for the batch API (real backend)
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket endpoint for real-time batch updates (future feature)
VITE_WS_URL=ws://localhost:8080/ws/batches

# Feature flags
VITE_ENABLE_LIVE_MODE=false
VITE_ENABLE_EXPORT=false

# Application environment (development | staging | production)
VITE_APP_ENV=development
